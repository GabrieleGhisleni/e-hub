{
  "name": "@ehub/podcasts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./web": "./src/web/entry.tsx",
    "./server": "./src/server/index.ts",
    "./note-guard": "./src/core/note-guard.ts",
    "./chat-context": "./src/core/chat-context.ts",
    "./schema": "./src/core/schema.ts",
    "./paths": "./src/core/paths.ts"
  },
  "scripts": {
