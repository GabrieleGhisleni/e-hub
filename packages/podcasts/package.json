    "lucide-react": "^1.70.0",
    "minisearch": "^7.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
