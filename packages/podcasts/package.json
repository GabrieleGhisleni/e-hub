    "@ehub/notes": "workspace:*",
    "@ehub/store": "workspace:*",
    "@ehub/ui": "workspace:*",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "^5.12.0",
