{
  "name": "@ehub/store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Storage seam: file I/O that can be mounted on Turso (documents) and R2 (blobs), plus in-memory fakes for tests",
  "exports": {
    ".": "./src/index.ts",
    "./hosted": "./src/hosted.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "tsx": "^4.23.15"
  }
}
