# Copy to packages/library/.env (git-ignored) and fill in. Read by `pnpm server` at startup; variables already set in
# the shell win. Never commit the real .env.

# Z-Library mirror used by the book search (leave empty for the default).
ZLIBRARY_BASE_URL=https://z-library.sk

# Account: either an existing session (preferred: no sign-in request), or email + password.
# Session cookies: remix_userid / remix_userkey.
ZLIBRARY_USER_ID=
ZLIBRARY_USER_KEY=

# Credentials; the resulting session is cached under the server cache dir.
ZLIBRARY_EMAIL=
ZLIBRARY_PASSWORD=
