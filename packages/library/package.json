{
  "name": "@ehub/library",
  "version": "1.0.0",
  "private": true,
  "description": "Personal EPUB library: local admin + static public site",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./web": "./src/web/entry.tsx",
    "./vite": "./src/node/vite/index.ts",
    "./config": "./src/node/config/index.ts",
    "./chat-context": "./src/node/chat/index.ts",
    "./explore": "./src/node/explore/index.ts"
  },
  "scripts": {
    "dev": "pnpm server",
    "server": "tsx watch src/node/server/main.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx src/node/site-data/validate-cli.ts",
    "demo-data": "tsx scripts/demo-data.ts",
    "elib": "tsx src/node/cli/main.ts"
  },
  "dependencies": {
    "@ehub/chat": "workspace:*",
    "@ehub/notes": "workspace:*",
    "@ehub/store": "workspace:*",
    "@ehub/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.1.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  }
}
