{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@library": ["../../packages/library/src/web"],
      "@library/*": ["../../packages/library/src/web/*"],
      "@podcasts": ["../../packages/podcasts/src/web"],
      "@podcasts/*": ["../../packages/podcasts/src/web/*"],
      "@shared": ["../../packages/library/src/shared"],
      "@shared/*": ["../../packages/library/src/shared/*"],
      "@core": ["../../packages/podcasts/src/core"],
      "@core/*": ["../../packages/podcasts/src/core/*"]
    }
  },
  "include": ["src"]
}
