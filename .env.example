# Copy to .env.local (gitignored) and fill in. Used by `pnpm dev` and the chat smoke test.

# OpenAI-compatible endpoint. Include the /v1 suffix.
EHUB_AI_BASE_URL=https://your-endpoint.example.com/v1
EHUB_AI_API_KEY=your-api-key

# Optional. Defaults shown.
EHUB_AI_MODEL=smart
# Summaries (elib summarize) use the router's fast tier by default. Reasoning off (none) makes them quick,
# about 15 s per chapter. Use `default` to leave reasoning_effort unset.
# EHUB_AI_SUMMARY_MODEL=fast
# EHUB_AI_SUMMARY_REASONING_EFFORT=none
# Context window budget in tokens (positive integer).
# EHUB_AI_MAX_CONTEXT_TOKENS=1000000
