# Copy to .env.local (gitignored) and fill in. Used by `pnpm dev` and the chat smoke test.

# The token of the freeway router (one of the ROUTER_TOKENS set on the Pi: `deploy/env.sh new-token` in freeway).
EHUB_AI_API_KEY=your-router-token

# Optional. OpenAI-compatible endpoint, with the /v1 suffix. Default: the freeway router on the Pi,
# https://freeway.gabrieleghisleni.dev/v1. Use http://127.0.0.1:4100/v1 for a router started locally.
# EHUB_AI_BASE_URL=https://freeway.gabrieleghisleni.dev/v1

# Optional. Defaults shown.
EHUB_AI_MODEL=smart
# Model of the chat's "Feel rich" toggle (not on freeway yet: until it is, the chat says so and you turn it off).
# EHUB_AI_RICH_MODEL=gpt-6-luna
# Chat reasoning: off (none) by default, so replies start sooner. Use `default` to leave reasoning_effort unset,
# or e.g. `low` / `medium`.
# EHUB_AI_REASONING_EFFORT=none
# Summaries (elib summarize) use the router's fast tier by default. Reasoning off (none) makes them quick,
# about 15 s per chapter. Use `default` to leave reasoning_effort unset.
# EHUB_AI_SUMMARY_MODEL=fast
# EHUB_AI_SUMMARY_REASONING_EFFORT=none
# Parallel model calls per summary (default 4) / Chiamate al modello in parallelo per sintesi (default 4). Max 8.
# EHUB_AI_SUMMARY_CONCURRENCY=4
# Context window budget in tokens (positive integer).
# EHUB_AI_MAX_CONTEXT_TOKENS=1000000

# --- Hosted setup (docs/hosting.md). Only the Pi server and the migration script read these. ---
# Turso (libSQL): database URL and a token with write access. Pi and migration scripts only.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# Login: Google OAuth client handled by the API, session secret (>= 32 random characters), public URL of the API.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# PUBLIC_API_URL=https://<api host>
# ALLOWED_EMAILS=
# Cloudflare R2 (private bucket, S3 API token with read/write on that bucket).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Hosted site build (GitHub Pages workflow sets them): data and login come from the API.
# VITE_HOSTED=1
# VITE_API_URL=https://<api host>
