# Copy to /etc/ehub/env on the Pi (chmod 600, owner root). Names only: fill in the values there.
PORT=8788
HOST=127.0.0.1
# Origin of the site on GitHub Pages (no path), comma separated if more than one.
CORS_ORIGINS=https://<user>.github.io
EHUB_DATA_ROOT=/var/lib/ehub/data
ELIB_CONFIG=/opt/ehub/elib.config.json
ELIB_CACHE_DIR=/var/cache/ehub/e-library
# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
ALLOWED_EMAILS=
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Chat / summaries (freeway router on this Pi)
EHUB_AI_API_KEY=
EHUB_AI_BASE_URL=http://127.0.0.1:4100/v1
