# Copy to /etc/ehub/env on the Pi (chmod 600, owner root). Names only: fill in the values there.
PORT=8788
HOST=127.0.0.1
# Origin of the site on GitHub Pages (no path), comma separated if more than one.
CORS_ORIGINS=https://<user>.github.io
EHUB_DATA_ROOT=/var/lib/ehub/data
ELIB_CONFIG=/opt/ehub/elib.config.json
ELIB_CACHE_DIR=/var/cache/ehub/e-library
# Turso (libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Login with Google, handled by the API. PUBLIC_API_URL is the address of the tunnel.
PUBLIC_API_URL=https://<api host>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters: signs the session tokens.
SESSION_SECRET=
ALLOWED_EMAILS=
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Chat / summaries (freeway router on this Pi)
EHUB_AI_API_KEY=
EHUB_AI_BASE_URL=http://127.0.0.1:4100/v1

# Kobo (optional: they override elib.config.json; the host may change with DHCP, the alias keeps the host key check strict)
# ELIB_KOBO_HOST=root@192.168.1.12
# ELIB_KOBO_PORT=2222
# ELIB_KOBO_HOST_KEY_ALIAS=ehub-kobo
ELIB_KOBO_QUEUE=1
GROQ_API_KEY=
